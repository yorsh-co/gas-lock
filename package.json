{
  "name": "gas-lock",
  "version": "1.2.4",
  "private": true,
  "description": "Reentrancy-safe wrapper around Apps Script's LockService.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-lock.git"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gasdev/prettier",
  "gasdev": {
    "loadOrder": [
      "gas-lock.types.ts",
      "gas-lock.constants.ts",
      "gas-lock.ts"
    ],
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/script.storage"
      ]
    },
    "release": {
      "githubRelease": true
    }
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "gasdev": "github:yorsh-co/gasdev#v3.0.0-beta.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gasdev release",
    "build": "npm run clean && tsc",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:watch": "tsc --watch",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p gas-test/tsconfig.json --noEmit && echo '✓ TypeScript passed'",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gasdev check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gas:build": "gasdev gas-test build",
    "test:gas": "gasdev gas-test run"
  }
}
